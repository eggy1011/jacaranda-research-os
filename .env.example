# Copy this file to .env for local overrides. Keep every committed value empty.

# Application — API_BASE_URL is server-only; never prefix provider settings with NEXT_PUBLIC_.
APP_ENV=
API_BASE_URL=
DATABASE_URL=
REDIS_URL=
# Root directory for run artifacts and uploads (a shared volume in Compose)
DATA_DIR=

# Local PostgreSQL service
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# LLM — server-side only. Model policy: ordered candidate list, free first; paid candidates only
# with ALLOW_PAID_MODELS explicitly enabled (D-008). Never a silent paid fallback.
LLM_PROVIDER=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
LLM_MAX_ATTEMPTS=
# Comma-separated ordered candidates, e.g. free model ids first (read from Phase 1 onwards)
OPENROUTER_MODELS=
ALLOW_PAID_MODELS=

# Market data
FINNHUB_API_KEY=
FMP_API_KEY=
SEC_USER_AGENT=
